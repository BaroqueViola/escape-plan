# Copy this file to .env and fill in your own values. Never commit .env.

# ElevenLabs text-to-speech (optional: without it, emotes use sound effects and chat is text only)
ELEVENLABS_API_KEY=
# Voice IDs from your ElevenLabs voice library (defaults: George for the warden, Rachel for the prisoner)
ELEVENLABS_VOICE_WARDEN=
ELEVENLABS_VOICE_PRISONER=
# Credit caps (free plan = 10,000 credits/month)
VOICE_DAILY_CREDITS=300
VOICE_MONTHLY_CREDITS=9000

# Admin page password
ADMIN_PASSWORD=admin123
